# ==== MySQL ====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=xianyu_core
MYSQL_USER=xianyu
MYSQL_PASSWORD=xianyu123

# Cookie 加密密钥（AES-256-GCM，务必修改；丢失 = 所有已存登录态作废）
COOKIE_CRYPTO_SECRET=change-me-in-production

# JWT 签名密钥（务必修改；泄露 = 可伪造任意登录令牌）
JWT_SECRET=change-me-jwt-secret

# ==== Redis ====
REDIS_URL=redis://localhost:6379/0

# ==== AI（OpenAI 兼容，可换 DeepSeek/通义） ====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
